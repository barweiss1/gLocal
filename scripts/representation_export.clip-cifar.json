{
  "features_root": "../features-export",
  "device": "cuda",
  "logical_batch_size": 1024,
  "compute_batch_size": 32,
  "num_workers": 2,
  "allow_download": true,
  "transform_validation": "selected",
  "transforms": ["none", "global", "glocal", "naive"],
  "models": [
    {
      "name": "clip_RN50",
      "source": "custom",
      "layer": "visual",
      "global_transform": "${CLIP_RN50_GLOBAL_TRANSFORM}",
      "glocal_transform": "../transforms/clip_RN50/visual/transform.npz",
      "naive_transform": "${CLIP_RN50_NAIVE_TRANSFORM}"
    },
    {
      "name": "clip_ViT-L/14",
      "slug": "clip_ViT-L-14",
      "source": "custom",
      "layer": "visual",
      "global_transform": "${CLIP_VIT_L14_GLOBAL_TRANSFORM}",
      "glocal_transform": "../transforms/clip_ViT-L/14/visual/transform.npz",
      "naive_transform": "${CLIP_VIT_L14_NAIVE_TRANSFORM}"
    },
    {
      "name": "OpenCLIP_ViT-L-14_laion400m_e32",
      "source": "custom",
      "layer": "visual",
      "global_transform": "${OPENCLIP_LAION400M_GLOBAL_TRANSFORM}",
      "glocal_transform": "../transforms/OpenCLIP_ViT-L-14_laion400m_e32/visual/transform.npz",
      "naive_transform": "${OPENCLIP_LAION400M_NAIVE_TRANSFORM}"
    },
    {
      "name": "OpenCLIP_ViT-L-14_laion2b_s32b_b82k",
      "source": "custom",
      "layer": "visual",
      "global_transform": "${OPENCLIP_LAION2B_GLOBAL_TRANSFORM}",
      "glocal_transform": "../transforms/OpenCLIP_ViT-L-14_laion2b_s32b_b82k/visual/transform.npz",
      "naive_transform": "${OPENCLIP_LAION2B_NAIVE_TRANSFORM}"
    }
  ],
  "datasets": [
    {
      "name": "cifar10",
      "root": "../datasets",
      "splits": ["test"]
    },
    {
      "name": "cifar100",
      "root": "../datasets",
      "splits": ["test"]
    },
    {
      "name": "cifar100-coarse",
      "root": "../datasets",
      "splits": ["test"]
    }
  ]
}
